# The released images the real-server tests run against (tf#86), read by
# docker compose (--env-file) and by run.sh. Released versions only: a fix
# that is not released yet is checked on test01, not here.
KIT_VERSION=1.98.0
GUARD_CONTROL_VERSION=0.35.3
PLATFORM_STUB_VERSION=0.14.1
ID_VERSION=0.13.0

# Tests known to fail on these versions, each with the issue that fixes it.
# ci.sh runs them apart and requires them to fail, so a red job is never one
# of these, and one that starts passing turns the job red until it is
# removed from here.
#   TestReal_RealmAuthenticationPolicySkipIfDeviceTrusted: kit#1026 (tf#87).
#   Through kit 1.98.0 skip_if_device_trusted is a plain bool, so kit reads
#   an explicit false on the floor back as unset and that step never plans
#   clean. Fixed in the first kit release that carries kit#1026.
KNOWN_FAILING_TESTS=TestReal_RealmAuthenticationPolicySkipIfDeviceTrusted
